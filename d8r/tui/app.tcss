/* Theme-relative surfaces keep the workspace soft in light and dark palettes. */

Screen {
    background: $background;
    layers: base;
}

Tooltip {
    background: $panel;
    color: $foreground;
    border: round $primary 65%;
    padding: 0 1;
}

/* Flat controls preserve the one-row toolbars without simulated bevels. */
Button {
    color: $foreground;
    background: $surface;
    border: round $foreground 18%;
    text-style: none;
}

Button:hover {
    background: $primary 16%;
    border: round $primary 65%;
    background-tint: $primary 8%;
}

Button.-active {
    background: $primary 25%;
    border: round $primary;
    tint: transparent;
}

Button.-primary {
    background: $primary 20%;
    border: round $primary 65%;
}

Button.-success {
    background: $success 18%;
    border: round $success 65%;
}

Button.-warning {
    background: $warning 18%;
    border: round $warning 65%;
}

Button.-error {
    background: $error 15%;
    border: round $error 65%;
}

Button.-textual-compact {
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    border: none !important;
}

Button:focus {
    text-style: bold underline;
    background-tint: $primary 12%;
}

Button:disabled {
    opacity: 55%;
}

#open-ai, #fn-ai {
    background: $accent 20%;
    color: $text;
}

#query-to-fn {
    width: 1fr;
    height: auto;
    text-wrap: wrap;
    background: $warning 20%;
    color: $text;
}

#open-ai:hover, #fn-ai:hover,
#query-to-fn:hover {
    background-tint: $foreground 8%;
}

/* Native Select geometry and keyboard handling stay with Textual. */
Select > SelectCurrent {
    background: $surface;
    color: $foreground;
    border: round $foreground 20%;
    padding: 0 1;
}

SelectCurrent Static#label,
SelectCurrent .arrow {
    color: $text-muted;
}

SelectCurrent.-has-value Static#label {
    color: $foreground;
}

Select:hover > SelectCurrent {
    border: round $primary 60%;
    background-tint: $primary 6%;
}

Select:focus > SelectCurrent,
Select.-expanded > SelectCurrent {
    border: round $primary;
    background-tint: $primary 10%;
}

Select:focus SelectCurrent .arrow,
Select.-expanded SelectCurrent .arrow {
    color: $primary;
}

Select:disabled > SelectCurrent {
    border: round $foreground 12%;
    background-tint: transparent;
}

Select:disabled SelectCurrent Static#label,
Select:disabled SelectCurrent .arrow {
    color: $text-disabled;
}

Select > SelectOverlay,
CommandPalette {
    background: $surface;
    color: $foreground;
    border: round $primary 65%;
    padding: 0;
    overflow-x: hidden;
    overflow-y: auto;
    scrollbar-size-vertical: 1;
    scrollbar-background: $surface;
    scrollbar-background-hover: $surface;
    scrollbar-background-active: $surface;
    scrollbar-color: $primary 35%;
    scrollbar-color-hover: $primary 60%;
    scrollbar-color-active: $primary;
    scrollbar-corner-color: $surface;
}

Select > SelectOverlay {
    max-height: 12;
}

Select > SelectOverlay:focus,
CommandPalette:focus {
    border: round $primary;
    background-tint: transparent;
}

SelectOverlay > .option-list--option,
CommandPalette > .option-list--option {
    padding: 0 1;
    color: $foreground;
    text-style: none;
}

SelectOverlay > .option-list--option-hover,
CommandPalette > .option-list--option-hover {
    background: $primary 12%;
    color: $foreground;
    text-style: none;
}

SelectOverlay > .option-list--option-highlighted,
SelectOverlay:focus > .option-list--option-highlighted,
CommandPalette > .option-list--option-highlighted,
CommandPalette:focus > .option-list--option-highlighted {
    background: $primary 24%;
    color: $foreground;
    text-style: bold;
}

SelectOverlay > .option-list--option-disabled,
CommandPalette > .option-list--option-disabled {
    background: transparent;
    color: $text-disabled;
    text-style: dim;
}

SelectOverlay > .option-list--separator,
CommandPalette > .option-list--separator {
    color: $foreground 18%;
}

/* Accent the resting button's outline and label, not its rectangular backing. */
Tabs {
    height: 3;
    background: $background;
}

Tabs Underline {
    display: none;
}

Tabs Tab {
    height: 3;
    margin-right: 1;
    padding: 0 1;
    border: round $foreground 18%;
    background: $panel;
    color: $text-muted;
}

Tabs Tab:hover {
    border: round $primary 60%;
    color: $text;
}

Tabs Tab.-active, Tabs:focus Tab.-active {
    border: round $primary;
    background: $panel;
    color: $foreground;
    text-style: bold;
}

Tabs:focus Tab.-active {
    text-style: bold underline;
}

Tabs Tab:disabled {
    color: $text-disabled;
    border: round $panel;
}

/* -- header ------------------------------------------------------------- */

#query-header {
    height: auto;
    background: $panel;
}


#query-targets {
    height: 3;
}


#query-targets Select {
    width: 1fr;
    min-width: 12;
}

#source-version {
    width: 1fr;
    height: 3;
    padding: 1;
    color: $text-muted;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#query-targets SelectCurrent {
    height: 3;
    padding: 0 1;
}

#query-targets SelectCurrent Static {
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#query-targets SelectOverlay {
    min-width: 12;
}


#reconnect-source, #query-new {
    width: auto;
    min-width: 11;
    margin: 0 0 0 1;
}

/* -- body --------------------------------------------------------------- */

#body {
    height: 1fr;
}

.pane-controls {
    height: 1;
    background: $panel;
}

.pane-controls .pane-title {
    width: 1fr;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.pane-controls Button.pane-close {
    width: 5;
    min-width: 5;
    height: 1;
    padding: 0;
    margin: 0;
    color: $text-muted;
}

.pane-controls Button.pane-close:hover {
    color: $error;
}

#explorer-slot {
    width: 36;
    min-width: 0;
}

#schema-pane, #fn-list-pane {
    width: 1fr;
    height: 1fr;
}

#schema-pane Tree {
    height: 1fr;
    background: $surface;
}

#explorer-tabs, #explorer-tabs ContentSwitcher, #tab-schema, #tab-pages, #tab-functions, #tab-dbt {
    height: 1fr;
    padding: 0;
}

DbtExplorer { height: 1fr; }
.dbt-explorer-actions { height: 1; }
.dbt-explorer-actions Button { min-width: 0; margin-right: 1; }
#dbt-tree { height: 1fr; background: $surface; }
#dbt-explorer-status { max-height: 4; height: auto; color: $text-muted; }
#dbt-panels, #dbt-panels ContentSwitcher, #dbt-panels TabPane, DbtLineage, DbtProblems { height: 1fr; padding: 0; }
#dbt-lineage-tree, #dbt-problems-list { height: 1fr; background: $surface; }
.dbt-panel-status { max-height: 4; height: auto; color: $text-muted; }

#page-actions {
    height: 1;
}

#page-actions Button {
    height: 1;
    min-width: 0;
    margin-right: 1;
}

#page-search {
    height: 1;
    border: none;
    padding: 0 1;
    background: $panel;
}

#pages-list {
    height: 1fr;
    border: none;
}

#pages-hint {
    height: auto;
    padding: 0 1;
    color: $text-muted;
    background: $panel;
}

#work-bench {
    width: 1fr;
    min-width: 0;
    layers: base overlay;
}

#editor-slot {
    height: 22;
    min-height: 0;
    layers: base overlay;
}

#output-slot {
    height: 1fr;
    min-height: 0;
}

#function-editor, #function-output {
    display: none;
}

#function-editor, #function-output {
    height: 1fr;
    min-width: 0;
}

.pane-title {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
    text-style: bold;
}

/* -- editor + palette --------------------------------------------------- */

#dbt-compile-split { height: 1fr; }
#dbt-compiled-pane {
    display: none;
    height: 1fr;
    width: 1fr;
    min-width: 0;
    border-left: solid $primary;
}
#dbt-compiled-status { height: 1; padding: 0 1; text-wrap: nowrap; text-overflow: ellipsis; }
#dbt-compiled-sql { height: 1fr; border: none; }
#dbt-compiled-actions { height: 1; }
#dbt-compiled-actions Button { width: auto; min-width: 0; padding: 0 1; }

#editor-pane {
    height: 1fr;
    width: 1fr;
    min-width: 0;
    layers: base overlay;
}

#editor-tools, #dbt-editor-tools {
    height: 1;
    background: $panel;
}

#editor-tools Button, #dbt-editor-tools Button {
    width: auto;
    min-width: 0;
    margin-right: 1;
    padding: 0 1;
}

#dbt-view-controls { width: auto; height: 1; }
.dbt-switch-label { width: auto; margin: 0 1; }
#dbt-toggle { height: 1; padding: 0; border: none; }
#dbt-file-path { height: 1; color: $text-accent; text-overflow: ellipsis; text-wrap: nowrap; }

#refresh-schema {
    width: 1fr;
    min-width: 0;
}

#document-actions, #fn-actions {
    height: 1;
    background: $panel;
}

#fn-actions .pane-title {
    width: 1fr;
}

#document-actions Button, #fn-actions Button {
    height: 1;
    min-width: 8;
    margin: 0 1 0 0;
}

#document-actions Button {
    width: 1fr;
    max-width: 16;
    min-width: 0;
    padding: 0;
}

#fn-actions #fn-close {
    width: 5;
    min-width: 5;
    margin: 0;
}

#page-details {
    display: none;
    height: auto;
    padding: 0 1;
    background: $panel;
}

#page-details-heading {
    height: 1;
}

#page-details-heading .pane-title {
    width: 1fr;
}

#page-details-heading Button {
    min-width: 0;
    margin-left: 1;
}

#page-name {
    height: 3;
}

#page-description {
    height: 4;
    border: round $foreground 18%;
}

#page-details-status {
    height: 1;
    color: $text-muted;
}

#document-actions #page-details-toggle {
    min-width: 19;
    max-width: 19;
}

#editor {
    height: 1fr;
    border: none;
    background: $surface;
}

CommandPalette {
    layer: overlay;
    position: absolute;
    /* The palette re-places itself under the caret on every keystroke; these
       are only the values it starts from and the shape it keeps. */
    offset: 1 2;
    width: 86;
    max-height: 12;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    display: none;
}

CommandPalette.open {
    display: block;
}

.completion-details {
    layer: overlay;
    position: absolute;
    display: none;
    background: $surface;
    color: $foreground;
    border: round $primary 65%;
    padding: 0 1;
    max-height: 8;
    overflow-y: auto;
    text-wrap: wrap;
}

#history-preview {
    layer: overlay;
    position: absolute;
    display: none;
    width: 68;
    height: 12;
    border: round $primary;
    padding: 0 1;
    background: $panel;
    color: $text;
    overflow: hidden hidden;
    text-wrap: nowrap;
}

/* -- results ------------------------------------------------------------ */

#result-tabs {
    height: 1fr;
}

/* Keep the drag highlight visible behind the titled rule and between buttons. */
#output-controls, #output-controls .pane-title {
    background: transparent;
}

#results-actions {
    height: 1;
    width: auto;
}

#result-pager {
    display: none;
    height: 1;
    padding: 0 1;
}

#result-page-number {
    width: auto;
    height: 1;
    margin-right: 1;
}

#result-pager Button {
    width: auto;
    min-width: 0;
    margin-right: 1;
}

#results-table {
    height: 1fr;
}

#results-error {
    display: none;
    height: auto;
    padding: 0 1;
    color: $error;
    text-style: bold;
}

#results-error.error {
    display: block;
}

#results-status {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
}

#output-controls Button {
    max-width: 5;
    min-width: 0;
    line-pad: initial;
    padding: 0;
    margin: 0 1 0 0;
}

#output-controls #results-export {
    max-width: 6;
}

#output-controls .pane-close {
    width: 3;
    margin: 0;
}

.data-table {
    height: 1fr;
}

.data-status {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
}

#sql-text {
    height: 1fr;
    border: none;
    background: $surface;
}

#history-table {
    height: 1fr;
}

/* -- footer ------------------------------------------------------------- */

#footer {
    height: 2;
    background: $panel;
}

#keymap {
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

#status {
    height: 1;
    padding: 0 1;
    color: $text;
    text-style: bold;
}

/* -- add-source modal --------------------------------------------------- */

AddSourceModal {
    align: center middle;
    background: $background 60%;
}

#add-source {
    width: 74;
    max-height: 90%;
    padding: 1 2;
    background: $surface;
    border: round $accent;
}

#add-source-title {
    text-style: bold;
    color: $accent;
}

#add-source-note {
    color: $text-muted;
    padding: 0 0 1 0;
}

#postgres-fields, #parquet-fields, #d1-fields {
    height: auto;
}

#add-source .field-label {
    padding: 1 0 0 0;
    color: $text-muted;
}

#add-source-message {
    height: auto;
    padding: 1 0 0 0;
    color: $text-muted;
}

#add-source-message.error {
    color: $error;
}

#add-source-buttons {
    dock: bottom;
    background: $surface;
    height: auto;
    padding: 1 0 0 0;
}

#add-source-buttons Button {
    margin: 0 1 0 0;
}

/* -- settings ----------------------------------------------------------- */

SettingsScreen {
    align: center middle;
    background: $background;
}

#settings {
    width: 100%;
    height: 100%;
    padding: 1 2;
}

#settings-title {
    height: 1;
    text-style: bold;
    color: $accent;
}

#settings-workspace {
    height: 1fr;
    margin-top: 1;
}

#settings-sidebar-pane {
    width: 26;
    max-width: 35%;
    height: 1fr;
    padding-right: 1;
    border-right: solid $foreground 18%;
}

#settings-nav-title {
    height: 1;
    padding-left: 1;
    margin-bottom: 1;
    color: $text-muted;
}

#settings-sidebar {
    height: 1fr;
    background: $background;
    border: none;
}

#settings-content {
    width: 1fr;
    min-width: 0;
    height: 1fr;
    padding-left: 2;
}

#settings-heading {
    height: auto;
    text-style: bold;
    color: $accent;
}

#settings-description {
    height: auto;
    margin: 1 0;
    color: $text-muted;
}

#workspace-dbt-setting { height: 3; align: left middle; }
#workspace-dbt-label { width: auto; height: 1; margin-right: 2; }

#settings-menu {
    height: 1fr;
    background: $surface;
    border: round $foreground 18%;
}

#settings-menu:focus {
    border: round $accent;
}

#settings-hint {
    height: auto;
    padding: 1 0 0 0;
    color: $text-muted;
}

/* -- function library (\\fn) -------------------------------------------- */

#fn-list {
    height: 1fr;
    background: $surface;
    border: none;
}

#fn-param-guide {
    height: 40%;
    min-height: 0;
    padding: 1;
    background: $panel;
    color: $text-muted;
}

#fn-param-guide .guide-title {
    color: $accent;
    text-style: bold;
    margin-bottom: 1;
}


#fn-editor {
    width: 1fr;
    height: 1fr;
    padding: 0;
}

#fn-editor .field-label {
    padding: 0;
    color: $text-muted;
}

.fn-field {
    height: 1;
}

.fn-field Static {
    width: 15;
    color: $text-muted;
}

.fn-field Input {
    width: 1fr;
    height: 1;
    border: none;
    padding: 0 1;
}

#fn-status {
    height: auto;
    max-height: 3;
    color: $text-muted;
}

#fn-status.error {
    color: $error;
}

#fn-body-pane {
    /* Last row of the form: grows to fill whatever the fixed fields leave. */
    height: 1fr;
    min-height: 4;
    layers: base overlay;
}

#fn-body {
    height: 1fr;
    background: $surface;
    border: round $foreground 18%;
}

#fn-buttons {
    height: auto;
    padding: 0;
}

#fn-buttons Button {
    height: 1;
    min-width: 6;
    width: 1fr;
    margin: 0 1 0 0;
}

#fn-grid {
    height: 1fr;
    min-height: 0;
}

/* -- in-layout AI assistant --------------------------------------------- */

#assistant-slot {
    width: 44;
    min-width: 0;
    height: 1fr;
    padding: 0 1;
    background: $surface;
}

#assistant-controls {
    dock: top;
    height: 1;
}

AIPanel {
    min-width: 0;
    width: 1fr;
    height: 1fr;
}

AIPanel .ai-notice {
    height: auto;
    max-height: 3;
    color: $text-muted;
}

AIPanel #ai-review {
    height: 1fr;
}

AIPanel #ai-conversation {
    height: 1fr;
    min-height: 3;
    margin-top: 1;
}

AIPanel #ai-transcript {
    height: auto;
}

AIPanel #ai-status {
    height: auto;
    max-height: 4;
    color: $text-muted;
    margin: 0;
}

AIPanel #ai-question {
    display: none;
    height: auto;
    margin-top: 1;
    padding: 0 1;
    border: round $accent;
    background: $panel;
}

AIPanel #ai-question-text {
    height: auto;
    margin: 1 0;
    text-style: bold;
}

AIPanel #ai-question-options {
    min-height: 4;
    max-height: 16;
    border: none;
    background: $panel;
}

AIPanel #ai-question-other {
    height: 3;
    margin-top: 1;
}

AIPanel #ai-question-hint {
    height: auto;
    color: $text-muted;
}

AIPanel #ai-question-submit {
    height: 1;
    margin-top: 1;
}

AIPanel #ai-proposal {
    min-height: 4;
    border: round $accent;
}

AIPanel #ai-input {
    height: 30%;
    min-height: 6;
    max-height: 12;
    padding: 0 1;
    border: round $foreground 18%;
    margin-top: 1;
}

AIPanel .ai-buttons {
    height: 1;
}

AIPanel Button {
    min-width: 6;
    width: 1fr;
    padding: 0;
}

AIPanel #ai-apply {
    width: 2fr;
}

AIPanel #ai-apply:enabled {
    background: #17643b;
    color: #ffffff;
    text-style: bold;
}

AIPanel #ai-apply:enabled:hover {
    background: #1f7a49;
}

AIPanel #ai-apply:enabled:focus {
    text-style: bold underline;
}

AIPanel #ai-function-details {
    height: auto;
    color: $accent;
}


/* -- AI diagnostic snapshot --------------------------------------------- */

AIDiagnosticsScreen {
    background: $background;
}

#ai-log-screen {
    width: 100%;
    height: 100%;
    padding: 1 2;
}

#ai-log-notice {
    height: auto;
    color: $text-muted;
    margin-bottom: 1;
}

#ai-log-text {
    height: 1fr;
    border: round $accent;
}

#ai-log-buttons {
    height: 3;
}

#ai-log-buttons Button {
    margin-right: 1;
}

/* -- independently running AI conversations ----------------------------- */

ConversationTabs {
    height: 3;
    min-width: 0;
    width: 1fr;
    background: $panel;
    align-vertical: middle;
}

ConversationTabs #conversation-strip {
    width: 1fr;
    min-width: 1;
    height: 3;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-size-horizontal: 1;
}

ConversationTab {
    width: auto;
    min-width: 8;
    max-width: 28;
    height: 2;
    margin-right: 1;
    border-bottom: solid $foreground 18%;
}

ConversationTab.selected {
    border-bottom: solid $primary;
    background: $primary 16%;
}

ConversationTabs Button {
    height: 1;
    min-width: 3;
    width: auto;
    padding: 0 1;
}

ConversationTab .conversation-select {
    width: auto;
    min-width: 5;
    max-width: 25;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

ConversationTab .conversation-close {
    width: 3;
    padding: 0;
}

ConversationTabs #conversation-history {
    width: 9;
}

ConversationTabs .conversation--busy {
    color: $accent;
    text-style: bold;
}

ConversationTabs .conversation--ready {
    color: $success;
}

ConversationTabs .conversation--seen {
    color: $text-muted;
}

ConversationTabs .conversation--error {
    color: $error;
}

ConversationTabs .conversation--cancelled {
    color: $warning;
}

ConversationHistory {
    align: center middle;
    background: $background 70%;
}

#conversation-history-dialog {
    width: 85%;
    max-width: 90;
    height: 80%;
    padding: 1;
    border: round $primary;
    background: $panel;
}

#conversation-history-dialog > Static {
    height: auto;
}

#conversation-history-list {
    height: 1fr;
}

#conversation-history-actions {
    height: 2;
}

#conversation-history-actions Button {
    min-width: 4;
    width: 1fr;
    padding: 0;
}
